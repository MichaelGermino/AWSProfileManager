[
  {
    "id": "UI-APPEARANCE-001",
    "title": "Choosing a new app icon saves it and switches the selection",
    "given": {
      "files": {
        "settings.json": {
          "setupCompleted": true,
          "seenTourIds": [
            "v1.5-features-ga",
            "v1.6-features"
          ],
          "lastChangelogVersionSeen": "9.9.9"
        }
      }
    },
    "steps": [
      {
        "click": {
          "role": "link",
          "name": "Settings",
          "within": {
            "role": "navigation"
          }
        }
      },
      {
        "click": {
          "role": "tab",
          "name": "Appearance"
        }
      },
      {
        "see": {
          "role": "button",
          "name": "Classic Original"
        },
        "state": "visible"
      },
      {
        "click": {
          "role": "button",
          "name": "Launchpad Retro flat"
        }
      },
      {
        "see": {
          "role": "button",
          "name": "Monochrome"
        },
        "state": "enabled"
      },
      {
        "call": "settings:get",
        "expect": {
          "$partial": true,
          "appIcon": "rocket"
        }
      }
    ]
  },
  {
    "id": "UI-APPEARANCE-002",
    "title": "Turning off the tray status badge is saved",
    "given": {
      "files": {
        "settings.json": {
          "setupCompleted": true,
          "seenTourIds": [
            "v1.5-features-ga",
            "v1.6-features"
          ],
          "lastChangelogVersionSeen": "9.9.9"
        }
      }
    },
    "steps": [
      {
        "click": {
          "role": "link",
          "name": "Settings",
          "within": {
            "role": "navigation"
          }
        }
      },
      {
        "click": {
          "role": "tab",
          "name": "Appearance"
        }
      },
      {
        "click": {
          "role": "checkbox",
          "name": "$match:^Show credential status on the tray icon"
        }
      },
      {
        "see": {
          "role": "checkbox",
          "name": "$match:^Show credential status on the tray icon"
        },
        "state": "unchecked"
      },
      {
        "call": "settings:get",
        "expect": {
          "$partial": true,
          "trayStatusBadge": false
        }
      }
    ]
  },
  {
    "id": "UI-APPEARANCE-003",
    "title": "Theme defaults to System; choosing Light is saved, pressed, and kept after a restart",
    "given": {
      "files": {
        "settings.json": {
          "setupCompleted": true,
          "seenTourIds": [
            "v1.5-features-ga",
            "v1.6-features"
          ],
          "lastChangelogVersionSeen": "9.9.9"
        }
      }
    },
    "steps": [
      {
        "click": {
          "role": "link",
          "name": "Settings",
          "within": {
            "role": "navigation"
          }
        }
      },
      {
        "click": {
          "role": "tab",
          "name": "Appearance"
        }
      },
      {
        "see": {
          "role": "button",
          "name": "System",
          "within": {
            "role": "group",
            "name": "Theme"
          }
        },
        "state": "pressed"
      },
      {
        "see": {
          "role": "button",
          "name": "Light",
          "within": {
            "role": "group",
            "name": "Theme"
          }
        },
        "state": "unpressed"
      },
      {
        "click": {
          "role": "button",
          "name": "Light",
          "within": {
            "role": "group",
            "name": "Theme"
          }
        }
      },
      {
        "see": {
          "role": "button",
          "name": "Light",
          "within": {
            "role": "group",
            "name": "Theme"
          }
        },
        "state": "pressed"
      },
      {
        "see": {
          "role": "button",
          "name": "System",
          "within": {
            "role": "group",
            "name": "Theme"
          }
        },
        "state": "unpressed"
      },
      {
        "call": "settings:get",
        "expect": {
          "$partial": true,
          "theme": "light"
        }
      },
      {
        "restart": true
      },
      {
        "click": {
          "role": "link",
          "name": "Settings",
          "within": {
            "role": "navigation"
          }
        }
      },
      {
        "click": {
          "role": "tab",
          "name": "Appearance"
        }
      },
      {
        "see": {
          "role": "button",
          "name": "Light",
          "within": {
            "role": "group",
            "name": "Theme"
          }
        },
        "state": "pressed"
      }
    ]
  },
  {

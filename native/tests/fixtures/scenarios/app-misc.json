[
  {
    "id": "BE-DASH-001",
    "title": "Dashboard status per profile: active, expired, never refreshed, and credentials missing from the file",
    "given": {
      "credentials": "[active]\naws_access_key_id=A\n\n[expired]\naws_access_key_id=B\n",
      "files": {
        "settings.json": {
          "accountDisplayNames": {
            "111122223333": "Shared"
          }
        },
        "profiles.json": {
          "profiles": [
            {
              "id": "a",
              "name": "Active",
              "idpEntryUrl": "",
              "label": "l-a",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "active",
              "expiration": "2099-01-01T00:00:00.000Z",
              "roleArn": "arn:aws:iam::111122223333:role/Dev",
              "iconName": "briefcase",
              "iconColor": "#3b82f6",
              "folderId": "f1"
            },
            {
              "id": "e",
              "name": "Expired",
              "idpEntryUrl": "",
              "label": "l-e",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "expired",
              "expiration": "2000-01-01T00:00:00.000Z",
              "roleDisplayText": "Custom text"
            },
            {
              "id": "n",
              "name": "Never",
              "idpEntryUrl": "",
              "label": "l-n",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "never"
            },
            {
              "id": "m",
              "name": "Missing",
              "idpEntryUrl": "",
              "label": "l-m",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "gone",
              "expiration": "2099-01-01T00:00:00.000Z",
              "authType": "identityCenter",
              "ssoAccountId": "444455556666",
              "ssoRoleName": "Admin"
            }
          ]
        }
      }
    },
    "steps": [
      {
        "call": "dashboard:getState",
        "expect": [
          {
            "id": "a",
            "name": "Active",
            "accountNumber": "Shared (111122223333) - Dev",
            "label": "l-a",
            "status": "active",
            "expiresAtPst": "$match:^12/31/2098, 4:00:00\\sPM$",
            "timeRemainingSeconds": "$number",
            "iconName": "briefcase",
            "iconColor": "#3b82f6",
            "folderId": "f1"
          },
          {
            "id": "e",
            "name": "Expired",
            "accountNumber": "Custom text",
            "label": "l-e",
            "status": "expired",
            "expiresAtPst": "$match:^12/31/1999, 4:00:00\\sPM$"
          },
          {
            "id": "n",
            "name": "Never",
            "accountNumber": "l-n",
            "label": "l-n",
            "status": "never"
          },
          {
            "id": "m",
            "name": "Missing",
            "accountNumber": "l-m",
            "label": "l-m",
            "status": "never"
          }
        ]
      }
    ]
  },
  {
    "id": "BE-REFRESHALL-003",
    "title": "Refresh all (tray) asks once for every SAML profile without credentials",
    "given": {
      "files": {
        "profiles.json": {
          "profiles": [
            {
              "id": "a",
              "name": "A",
              "idpEntryUrl": "https://idp.example.test/sso",
              "label": "",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "a",
              "expiration": "2099-01-01T00:00:00.000Z"
            },
            {
              "id": "b",
              "name": "B",
              "idpEntryUrl": "",
              "label": "",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "b"
            }
          ]
        }
      }
    },
    "steps": [
      {
        "expectEvents": "$any"
      },
      {
        "call": "auth:refreshAll",
        "expect": null
      },
      {
        "expectEvents": [
          [
            "auth:refreshAllRequired",
            [
              "a"
            ],
            []
          ]
        ]
      }
    ]
  },
  {
    "id": "BE-SYS-001",
    "title": "Installed browsers are listed as key/name pairs; version and bash-path picker work",
    "steps": [
      {
        "call": "system:listBrowsers",
        "expect": {
          "$each": {
            "key": "$nonEmptyString",
            "name": "$nonEmptyString"
          },
          "$minItems": 0
        }
      },
      {
        "call": "app:getVersion",
        "expect": "{APP_VERSION}"
      },
      {
        "dialogs": [
          null,
          "{SANDBOX}/bash.exe"
        ]
      },
      {
        "call": "settings:selectBashPath",
        "expect": {
          "canceled": true
        }
      },
      {
        "call": "settings:selectBashPath",
        "expect": {
          "path": "{SANDBOX}/bash.exe"
        }
      }
    ]
  },

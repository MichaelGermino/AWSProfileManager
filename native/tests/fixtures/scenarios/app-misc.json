  {
    "id": "BE-VIDEO-001",
    "title": "Choosing a background video copies it into app storage and records it; unsupported formats are refused; clearing forgets it",
    "given": {
      "sandboxFiles": {
        "clip.mp4": "not really a video, only the extension is checked",
        "clip.avi": "x"
      }
    },
    "steps": [
      {
        "dialogs": [
          null,
          "{SANDBOX}/clip.avi",
          "{SANDBOX}/clip.mp4"
        ]
      },
      {
        "call": "appearance:chooseVideo",
        "expect": {
          "canceled": true
        }
      },
      {
        "call": "appearance:chooseVideo",
        "expect": {
          "success": false,
          "error": "Unsupported format \".avi\". Use mp4 or webm."
        }
      },
      {
        "call": "appearance:chooseVideo",
        "expect": {
          "success": true,
          "fileName": "clip.mp4",
          "updatedAt": "$number"
        },
        "save": "chosen"
      },
      {
        "call": "settings:get",
        "expect": {
          "$partial": true,
          "backgroundVideoName": "clip.mp4",
          "backgroundVideoUpdatedAt": {
            "$ref": "chosen.updatedAt"
          },
          "backgroundVideoPath": "$match:[\\\\/]background[\\\\/]video-\\d+\\.mp4$"
        }
      },
      {
        "call": "appearance:clearVideo",
        "expect": null
      },
      {
        "call": "settings:get",
        "expect": {
          "$partial": true,
          "backgroundVideoPath": "$absent",
          "backgroundVideoName": "$absent"
        }
      }
    ]
  },
  {
    "id": "BE-LOGS-001",
    "title": "The auth audit log lists entries with the profile's current name and can be cleared",
    "given": {
      "files": {
        "profiles.json": {
          "profiles": [
            {
              "id": "p1",
              "name": "Dev",
              "idpEntryUrl": "",
              "label": "",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "dev"
            }
          ]
        }
      }
    },
    "steps": [
      {
        "call": "auth:refresh",
        "args": [
          "p1"
        ],
        "note": "no IdP URL: logged as a failure"
      },
      {
        "call": "logs:getAuthAuditEntries",
        "expect": {
          "$each": {
            "$partial": true,
            "t": "$number",
            "type": "failure",
            "source": "refreshProfile",
            "profileId": "p1",
            "profileName": "Dev",
            "error": "Profile has no IdP entry URL. Edit the profile and set the IdP URL."
          }
        }
      },
      {
        "call": "logs:clearAuthAudit",
        "expect": null
      },
      {
        "call": "logs:getAuthAuditEntries",
        "expect": []
      }
    ]
  },
  {
    "id": "BE-TERM-001",
    "title": "The terminal starts a PowerShell, runs typed input, and accepts resizes",
    "platforms": [
      "win32"
    ],
    "steps": [
      {
        "call": "terminal:start",
        "args": [
          {
            "shell": "powershell"
          }
        ],
        "expect": null
      },
      {
        "waitForStream": "terminal:data",
        "text": "PS "
      },
      {
        "call": "terminal:resize",
        "args": [
          120,
          40
        ],
        "expect": null
      },
      {
        "call": "terminal:write",
        "args": [
          "echo parity-$(6*7)\r"
        ],
        "expect": null
      },
      {
        "waitForStream": "terminal:data",
        "text": "parity-42"
      }
    ]
  },
  {
    "id": "BE-TERM-002",
    "title": "A shell that cannot start reports terminal:error instead of crashing",
    "platforms": [
      "win32"
    ],
    "given": {
      "files": {
        "settings.json": {
          "terminalShell": "bash",
          "bashPath": "C:\\definitely\\not\\here\\bash.exe"
        }
      }
    },
    "steps": [
      {
        "expectEvents": "$any"
      },
      {
        "call": "terminal:start",
        "args": [
          {
            "shell": "bash"
          }
        ],
        "expect": null
      },
      {
        "wait": 500
      },
      {
        "expectEvents": [
          [
            "terminal:error",
            "$nonEmptyString"
          ]
        ]
      },
      {
        "call": "terminal:write",
        "args": [
          "ignored\r"
        ],
        "expect": null
      }
    ]
  },
  {
    "id": "BE-CLIDOCS-001",
    "title": "The CLI service list and commands are scraped, cleaned, cached for 24 hours, then fetched again",
    "given": {
      "fakes": {
        "cliDocs": {
          "s3": [
            "ls",
            "cp"
          ],
          "ec2": [
            "describe-instances"
          ]
        }
      }
    },
    "steps": [
      {
        "wait": 2500,
        "note": "let the background mount finish its own fetch"
      },
      {
        "resetFakeRequests": true
      },
      {
        "call": "awsCli:getCachedServiceList",
        "expect": [
          "ec2",
          "s3"
        ],
        "note": "from cache"
      },
      {
        "call": "awsCli:getCachedCommands",
        "args": [
          "s3/"
        ],
        "expect": [
          {
            "id": "s3-ls",
            "name": "ls",
            "description": "",
            "syntax": "aws s3 ls [options]",
            "options": [],
            "examples": [],
            "mocked": false,
            "docUrl": "https://docs.aws.amazon.com/cli/latest/reference/s3/ls.html"
          },
          {
            "id": "s3-cp",
            "name": "cp",
            "description": "",
            "syntax": "aws s3 cp [options]",
            "options": [],
            "examples": [],
            "mocked": false,
            "docUrl": "https://docs.aws.amazon.com/cli/latest/reference/s3/cp.html"
          }
        ]
      },
      {
        "call": "awsCli:getCachedServiceList",
        "expect": [
          "ec2",
          "s3"
        ],
        "note": "still from cache"
      },
      {
        "advanceClock": 90000000
      },
      {
        "call": "awsCli:getCachedServiceList",
        "expect": [
          "ec2",
          "s3"
        ],
        "note": "cache expired after 24 h: fetched again"
      }
    ],
    "then": {
      "fakeRequests": [
        {
          "service": "docs",
          "expect": [
            {
              "$partial": true,
              "path": "/docs/cli/latest/reference/s3/"
            },
            {
              "$partial": true,
              "path": "/docs/cli/latest/"
            }
          ]
        }
      ]
    },
    "note": "1.x also fetches the service list on its own when the Terminal screen mounts in the background; the scenario waits for that and starts counting requests afterwards."
  }
]

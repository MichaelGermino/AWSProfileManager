[
  {
    "id": "BE-CRED-001",
    "title": "A fresh install is unlocked with no master password and no default credentials",
    "steps": [
      { "call": "credentials:getMasterPasswordStatus", "expect": { "unlocked": true } },
      { "call": "credentials:getMasterPasswordEnabled", "expect": false },
      { "call": "credentials:getDefaultDisplay", "expect": null }
    ]
  },
  {
    "id": "BE-CRED-002",
    "title": "Default credentials cannot be saved without a master password",
    "steps": [
      { "call": "credentials:setDefault", "args": ["alice", "pw1"], "expect": { "success": false, "error": "MASTER_PASSWORD_REQUIRED" } }
    ],
    "then": { "keychain": { "__default__": "$absent", "__default___username": "$absent" } }
  },
  {
    "id": "BE-CRED-003",
    "title": "Creating a master password validates confirmation and length",
    "steps": [
      { "call": "credentials:createMasterPassword", "args": ["longenough1", "different1"], "expect": { "success": false, "error": "Passwords do not match" } },
      { "call": "credentials:createMasterPassword", "args": ["short", "short"], "expect": { "success": false, "error": "Password must be at least 8 characters." } }
    ],
    "then": { "keychain": { "__master_password_verifier__": "$absent" } }
  },
  {
    "id": "BE-CRED-004",
    "title": "Creating a master password stores an encrypted verifier and enables it in settings",
    "steps": [
      { "call": "credentials:createMasterPassword", "args": ["Correct horse 1", "Correct horse 1"], "expect": { "success": true } },
      { "call": "credentials:getMasterPasswordStatus", "expect": { "unlocked": true } },
      { "call": "credentials:getMasterPasswordEnabled", "expect": true }
    ],
    "then": {
      "files": { "settings.json": { "json": { "$partial": true, "masterPasswordEnabled": true } } },
      "keychain": {
        "__master_password_verifier__": { "$decrypt": { "password": "Correct horse 1", "equals": "aws-profile-manager:master-password-verifier:v1" } }
      }
    }
  },
  {
    "id": "BE-CRED-005",
    "title": "Default credentials are stored as one encrypted JSON blob; a null password keeps the old one",
    "steps": [
      { "call": "credentials:createMasterPassword", "args": ["Correct horse 1", "Correct horse 1"] },
      { "call": "credentials:setDefault", "args": ["alice", "pw1"], "expect": null },
      { "call": "credentials:getDefaultDisplay", "expect": { "username": "alice", "hasPassword": true } },
      { "call": "credentials:setDefault", "args": ["alice2", null], "expect": null }
    ],
    "then": {
      "keychain": {
        "__default__": { "$decrypt": { "password": "Correct horse 1", "json": { "username": "alice2", "password": "pw1" } } },
        "__default___username": "$absent"
      }
    }
  },
  {
    "id": "BE-CRED-006",
    "title": "With an encrypted store the app starts locked; a wrong password is rejected; the right one unlocks",
    "given": {
      "files": { "settings.json": { "masterPasswordEnabled": true } },
      "keychain": {
        "__master_password_verifier__": { "$encrypt": { "password": "Correct horse 1", "plaintext": "aws-profile-manager:master-password-verifier:v1" } },
        "__default__": { "$encrypt": { "password": "Correct horse 1", "json": { "username": "bob", "password": "pw" } } }
      }
    },
    "steps": [
      { "call": "credentials:getMasterPasswordStatus", "expect": { "needsUnlock": true } },
      { "call": "credentials:getDefaultDisplay", "expect": { "username": "", "hasPassword": true, "locked": true } },
      { "call": "credentials:unlock", "args": ["wrong password"], "expect": { "success": false, "error": "Wrong password" } },
      { "call": "credentials:unlock", "args": ["Correct horse 1"], "expect": { "success": true } },
      { "call": "credentials:getMasterPasswordStatus", "expect": { "unlocked": true } },
      { "call": "credentials:getDefaultDisplay", "expect": { "username": "bob", "hasPassword": true } }
    ]
  },
  {
    "id": "BE-CRED-007",
    "title": "Legacy plaintext default credentials ask for a master password and get encrypted by it",
    "given": { "keychain": { "__default__": "pw", "__default___username": "bob" } },
    "steps": [
      { "call": "credentials:getMasterPasswordStatus", "expect": { "needsCreateMasterPassword": true } },
      { "call": "credentials:getDefaultDisplay", "expect": { "username": "bob", "hasPassword": true } },
      { "call": "credentials:createMasterPassword", "args": ["Correct horse 1", "Correct horse 1"], "expect": { "success": true } }
    ],
    "then": {
      "keychain": {
        "__default__": { "$decrypt": { "password": "Correct horse 1", "json": { "username": "bob", "password": "pw" } } },
        "__default___username": "$absent"
      }
    }
  },
  {
    "id": "BE-CRED-008",
    "title": "Forget all removes every stored secret, disables the master password and notifies the window",
    "given": {
      "dataDir": "two-folders",
      "files": { "settings.json": { "masterPasswordEnabled": true } },
      "keychain": {
        "__master_password_verifier__": { "$encrypt": { "password": "Correct horse 1", "plaintext": "aws-profile-manager:master-password-verifier:v1" } },
        "__default__": { "$encrypt": { "password": "Correct horse 1", "json": { "username": "bob", "password": "pw" } } },
        "p1": { "$encrypt": { "password": "Correct horse 1", "json": { "username": "u1", "password": "x" } } }
      }
    },
    "steps": [
      { "expectEvents": "$any" },
      { "call": "credentials:forgetAllAndResetMasterPassword", "expect": null },
      { "expectEvents": [["credentials:masterPasswordReset"]] },
      { "call": "credentials:getMasterPasswordEnabled", "expect": false },
      { "call": "credentials:getMasterPasswordStatus", "expect": { "unlocked": true } }
    ],
    "then": {
      "files": { "settings.json": { "json": { "$partial": true, "masterPasswordEnabled": false } } },
      "keychain": { "__master_password_verifier__": "$absent", "__default__": "$absent", "p1": "$absent" }
    }
  },
  {
    "id": "BE-CRED-009",
    "title": "masterPasswordEnabled with nothing encrypted self-heals to disabled",
    "given": { "files": { "settings.json": { "masterPasswordEnabled": true } } },
    "steps": [
      { "call": "credentials:getMasterPasswordStatus", "expect": { "unlocked": true } },
      { "call": "credentials:getMasterPasswordEnabled", "expect": false }
    ]
  },
  {
    "id": "BE-CRED-010",
    "title": "Encrypted secrets with the setting off re-enable the master password and lock",
    "given": {
      "keychain": {
        "__master_password_verifier__": { "$encrypt": { "password": "Correct horse 1", "plaintext": "aws-profile-manager:master-password-verifier:v1" } }
      }
    },
    "steps": [
      { "call": "credentials:getMasterPasswordStatus", "expect": { "needsUnlock": true } },
      { "call": "credentials:getMasterPasswordEnabled", "expect": true }
    ]
  },
  {
    "id": "BE-CRED-011",
    "title": "Forgetting default credentials removes them from the keychain",
    "steps": [
      { "call": "credentials:createMasterPassword", "args": ["Correct horse 1", "Correct horse 1"] },
      { "call": "credentials:setDefault", "args": ["alice", "pw1"] },
      { "call": "credentials:forgetDefault", "expect": null },
      { "call": "credentials:getDefaultDisplay", "expect": null }
    ],
    "then": { "keychain": { "__default__": "$absent", "__master_password_verifier__": "$v1cipher" } }
  },
  {
    "id": "BE-CRED-012",
    "title": "credentials:getStatus lists every profile as having no credentials (1.x stub)",
    "given": { "dataDir": "two-folders" },
    "steps": [
      {
        "call": "credentials:getStatus",
        "expect": [
          { "profileId": "p1", "hasCredentials": false },
          { "profileId": "p2", "hasCredentials": false },
          { "profileId": "p3", "hasCredentials": false }
        ]
      }
    ]
  }
]

[
  {
    "id": "BE-SETTINGS-001",
    "title": "Without settings.json the defaults are returned (bashPath auto-detected on Windows)",
    "note": "On a fresh install the window banks every shipped tour and the current version's release notes at startup, so those two keys may already be set.",
    "steps": [
      {
        "call": "settings:get",
        "expect": {
          "lastChangelogVersionSeen": "$optional:string",
          "seenTourIds": "$optional",
          "defaultSessionDurationHours": 1,
          "defaultIdpEntryUrl": "",
          "launchAtStartup": true,
          "startMinimizedToTray": false,
          "accountDisplayNames": {},
          "accountDisplayNamesDefault": {},
          "openWebUiApiUrl": "",
          "openWebUiApiKey": "",
          "openWebUiModel": "",
          "terminalShell": "powershell",
          "bashPath": "$string",
          "authLoggingEnabled": true
        }
      }
    ]
  },
  {
    "id": "BE-SETTINGS-002",
    "title": "Legacy defaultAccountDisplayNames becomes the default map and seeds accountDisplayNames",
    "given": { "files": { "settings.json": { "defaultAccountDisplayNames": { "111122223333": "Shared" } } } },
    "steps": [
      {
        "call": "settings:get",
        "expect": {
          "$partial": true,
          "defaultAccountDisplayNames": { "111122223333": "Shared" },
          "accountDisplayNamesDefault": { "111122223333": "Shared" },
          "accountDisplayNames": { "111122223333": "Shared" }
        }
      },
      { "call": "settings:getDefaultAccountDisplayNames", "expect": { "111122223333": "Shared" } }
    ]
  },
  {
    "id": "BE-SETTINGS-003",
    "title": "Once accountDisplayNames is saved it is used as-is, even when empty",
    "given": { "files": { "settings.json": { "accountDisplayNamesDefault": { "1": "One" }, "accountDisplayNames": {} } } },
    "steps": [
      { "call": "settings:get", "expect": { "$partial": true, "accountDisplayNamesDefault": { "1": "One" }, "accountDisplayNames": {} } }
    ]
  },
  {
    "id": "BE-SETTINGS-004",
    "title": "The removed consoleBrowserMode 'externalPrivate' reads as 'external'",
    "given": { "files": { "settings.json": { "consoleBrowserMode": "externalPrivate" } } },
    "steps": [{ "call": "settings:get", "expect": { "$partial": true, "consoleBrowserMode": "external" } }]
  },
  {
    "id": "BE-SETTINGS-005",
    "platforms": ["win32"],
    "title": "On Windows, choosing bash with no bash path saves PowerShell instead",
    "steps": [
      {
        "call": "settings:save",
        "args": [{ "defaultSessionDurationHours": 1, "defaultIdpEntryUrl": "", "launchAtStartup": false, "startMinimizedToTray": false, "terminalShell": "bash", "bashPath": "" }],
        "expect": null
      }
    ],
    "then": {
      "files": {
        "settings.json": {
          "text": "{\n  \"defaultSessionDurationHours\": 1,\n  \"defaultIdpEntryUrl\": \"\",\n  \"launchAtStartup\": false,\n  \"startMinimizedToTray\": false,\n  \"terminalShell\": \"powershell\",\n  \"bashPath\": \"\"\n}"
        }
      }
    }
  },
  {
    "id": "BE-SETTINGS-006",
    "title": "Saving writes exactly the object given, unknown keys included, and survives a restart",
    "steps": [
      {
        "call": "settings:save",
        "args": [{ "defaultSessionDurationHours": 4, "defaultIdpEntryUrl": "https://idp.example.test/sso", "launchAtStartup": false, "startMinimizedToTray": true, "terminalShell": "powershell", "bashPath": "C:\\Git\\bin\\bash.exe", "futureKey": { "a": 1 } }]
      },
      { "restart": true },
      {
        "call": "settings:get",
        "expect": { "$partial": true, "defaultSessionDurationHours": 4, "defaultIdpEntryUrl": "https://idp.example.test/sso", "startMinimizedToTray": true, "bashPath": "C:\\Git\\bin\\bash.exe", "futureKey": { "a": 1 } }
      }
    ]
  },
  {
    "id": "BE-SETTINGS-007",
    "title": "A malformed settings.json reads as defaults",
    "given": { "files": { "settings.json": "{{{" } },
    "steps": [{ "call": "settings:get", "expect": { "$partial": true, "defaultSessionDurationHours": 1, "launchAtStartup": true } }]
  },
  {
    "id": "BE-SETTINGS-008",
    "title": "settings:get returns the Open WebUI API key to the renderer (1.x behaviour, kept for parity)",
    "note": "CLAUDE.md says the renderer only sees a boolean; in fact settings:get includes the key. Flagged for review.",
    "given": { "files": { "settings.json": { "openWebUiApiUrl": "https://ai.example.test", "openWebUiApiKey": "sk-test-123", "openWebUiModel": "m" } } },
    "steps": [
      { "call": "settings:get", "expect": { "$partial": true, "openWebUiApiKey": "sk-test-123" } },
      { "call": "ai:getConfigStatus", "expect": { "configured": true } }
    ]
  }
]

[
  {
    "id": "BE-BACKUP-001",
    "title": "Cancelling the backup save dialog writes nothing",
    "steps": [
      {
        "dialogs": [
          null
        ]
      },
      {
        "call": "config:backup",
        "expect": {
          "canceled": true
        }
      }
    ]
  },
  {
    "id": "BE-BACKUP-002",
    "title": "A backup is version 2 with settings, profiles and folders, as 2-space JSON",
    "given": {
      "dataDir": "two-folders",
      "files": {
        "settings.json": {
          "setupCompleted": true,
          "seenTourIds": [
            "v1.5-features-ga",
            "v1.6-features"
          ],
          "defaultSessionDurationHours": 2
        }
      }
    },
    "steps": [
      {
        "dialogs": [
          "{SANDBOX}/backup.json"
        ]
      },
      {
        "call": "config:backup",
        "expect": {
          "success": true,
          "path": "{SANDBOX}/backup.json"
        }
      }
    ],
    "then": {
      "sandboxFiles": {
        "backup.json": {
          "json": {
            "version": 2,
            "settings": {
              "$partial": true,
              "setupCompleted": true,
              "defaultSessionDurationHours": 2
            },
            "profiles": [
              {
                "$partial": true,
                "id": "p1"
              },
              {
                "$partial": true,
                "id": "p2"
              },
              {
                "$partial": true,
                "id": "p3"
              }
            ],
            "folders": [
              {
                "id": "f1",
                "name": "Team A",
                "color": "#3b82f6"
              },
              {
                "id": "f2",
                "name": "Team B"
              }
            ]
          }
        }
      }
    }
  },
  {
    "id": "BE-BACKUP-003",
    "title": "Restore validates the file: cancel, not an object with profiles, missing settings",
    "given": {
      "sandboxFiles": {
        "no-profiles.json": {
          "version": 2,
          "settings": {}
        },
        "no-settings.json": {
          "version": 2,
          "profiles": []
        },
        "garbage.json": "not json"
      }
    },
    "steps": [
      {
        "dialogs": [
          null,
          "{SANDBOX}/no-profiles.json",
          "{SANDBOX}/no-settings.json",
          "{SANDBOX}/garbage.json"
        ]
      },
      {
        "call": "config:restore",
        "expect": {
          "canceled": true
        }
      },
      {
        "call": "config:restore",
        "expect": {
          "success": false,
          "error": "Invalid backup file: missing or invalid profiles."
        }
      },
      {
        "call": "config:restore",
        "expect": {
          "success": false,
          "error": "Invalid backup file: missing or invalid settings."
        }
      },
      {
        "call": "config:restore",
        "expect": {
          "success": false,
          "error": "$nonEmptyString"
        }
      }
    ]
  },
  {
    "id": "BE-BACKUP-004",
    "title": "Restore returns the backup for confirmation without applying it; a v1 backup has no folders",
    "given": {
      "dataDir": "two-folders",
      "sandboxFiles": {
        "v1.json": {
          "version": 1,
          "settings": {
            "defaultSessionDurationHours": 3
          },
          "profiles": [
            {
              "id": "r1",
              "name": "Restored",
              "idpEntryUrl": "",
              "label": "",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "restored"
            }
          ]
        }
      }
    },
    "steps": [
      {
        "dialogs": [
          "{SANDBOX}/v1.json"
        ]
      },
      {
        "call": "config:restore",
        "expect": {
          "confirm": true,
          "settings": {
            "defaultSessionDurationHours": 3,
            "openWebUiApiKeySet": false
          },
          "profiles": [
            {
              "id": "r1",
              "name": "Restored",
              "idpEntryUrl": "",
              "label": "",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "restored"
            }
          ],
          "folders": []
        }
      },
      {
        "call": "profiles:getAll",
        "expect": [
          {
            "$partial": true,
            "id": "p1"
          },
          {
            "$partial": true,
            "id": "p2"
          },
          {
            "$partial": true,
            "id": "p3"
          }
        ]
      }
    ]
  },
  {
    "id": "BE-BACKUP-005",
    "title": "Applying a restore replaces settings, profiles and folders",
    "given": {
      "dataDir": "two-folders"
    },
    "steps": [
      {
        "call": "config:applyRestore",
        "args": [
          {
            "defaultSessionDurationHours": 3,
            "setupCompleted": true
          },
          [
            {
              "id": "r1",
              "name": "Restored",
              "idpEntryUrl": "",
              "label": "",
              "autoRefresh": false,
              "refreshIntervalMinutes": 60,
              "credentialProfileName": "restored"
            }
          ],
          [
            {
              "id": "fx",
              "name": "Restored folder",
              "junk": 1
            }
          ]
        ],
        "expect": {
          "success": true
        }
      },
      {
        "call": "profiles:getAll",
        "expect": [
          {
            "$partial": true,
            "id": "r1"
          }
        ]
      },
      {
        "call": "folders:getAll",
        "expect": [
          {
            "id": "fx",
            "name": "Restored folder"
          }
        ]
      }
    ],
    "then": {
      "files": {
        "settings.json": {
          "json": {
            "$partial": true,
            "defaultSessionDurationHours": 3,
            "setupCompleted": true
          }
        },
        "folders.json": {
          "json": {
            "folders": [
              {
                "id": "fx",
                "name": "Restored folder"
              }
            ]
          }
        }
      }
    }
  },
  {
    "id": "BE-BACKUP-006",
    "title": "Restoring a backup with an API key applies the key without ever showing it to the window",
    "given": {
      "sandboxFiles": {
        "with-key.json": {
          "version": 2,
          "settings": {
            "defaultSessionDurationHours": 2,
            "openWebUiApiUrl": "https://ai.example.test",
            "openWebUiApiKey": "sk-from-backup",
            "openWebUiModel": "m"
          },
          "profiles": [],
          "folders": []
        }
      }
    },
    "steps": [
      {
        "dialogs": [
          "{SANDBOX}/with-key.json"
        ]
      },
      {
        "call": "config:restore",
        "expect": {
          "confirm": true,
          "settings": {
            "defaultSessionDurationHours": 2,
            "openWebUiApiUrl": "https://ai.example.test",
            "openWebUiModel": "m",
            "openWebUiApiKeySet": true
          },
          "profiles": [],
          "folders": []
        },
        "save": "r"
      },
      {
        "call": "config:applyRestore",
        "args": [
          {
            "$ref": "r.settings"
          },
          [],
          []
        ],
        "expect": {
          "success": true
        }
      },
      {
        "call": "ai:getConfigStatus",
        "expect": {
          "configured": true
        }
      }
    ],
    "then": {
      "files": {
        "settings.json": {
          "contains": [
            "sk-from-backup"
          ],
          "notContains": [
            "openWebUiApiKeySet"
          ]
        }
      }
    }
  },
  {
    "id": "BE-BACKUP-007",
    "title": "A backup leaves out the API key, and restoring it keeps the key saved on this machine",
    "given": {
      "files": {
        "settings.json": {
          "defaultSessionDurationHours": 2,
          "openWebUiApiUrl": "https://ai.example.test",
          "openWebUiApiKey": "sk-local",
          "openWebUiModel": "m"
        }
      }
    },
    "steps": [
      {
        "dialogs": [
          "{SANDBOX}/backup.json",
          "{SANDBOX}/backup.json"
        ]
      },
      {
        "call": "config:backup",
        "expect": {
          "success": true,
          "path": "{SANDBOX}/backup.json"
        }
      },
      {
        "call": "config:restore",
        "expect": {
          "confirm": true,
          "settings": {
            "$partial": true,
            "defaultSessionDurationHours": 2,
            "openWebUiApiKeySet": false
          },
          "profiles": [],
          "folders": []
        },
        "save": "r"
      },
      {
        "call": "config:applyRestore",
        "args": [
          {
            "$ref": "r.settings"
          },
          [],
          []
        ],
        "expect": {
          "success": true
        }
      },
      {
        "call": "ai:getConfigStatus",
        "expect": {
          "configured": true
        }
      }
    ],
    "then": {
      "sandboxFiles": {
        "backup.json": {
          "notContains": [
            "sk-local",
            "openWebUiApiKey"
          ]
        }
      },
      "files": {
        "settings.json": {
          "contains": [
            "sk-local"
          ],
          "notContains": [
            "openWebUiApiKeySet"
          ]
        }
      }
    },
    "note": "Fixed 2026-11-14: 1.x wrote the key into the backup in plain text."
  },
  {
    "id": "BE-ORG-001",
    "title": "Org config export carries only shareable settings, trimmed, never the API key",
    "given": {
      "files": {
        "settings.json": {
          "defaultIdpEntryUrl": " https://idp.example.test/sso ",
          "defaultSsoStartUrl": "https://d-1234567890.awsapps.com/start",
          "defaultSsoRegion": "us-west-2",
          "openWebUiApiUrl": "https://ai.example.test",
          "openWebUiApiKey": "sk-secret",
          "openWebUiModel": "model-a",
          "accountDisplayNames": {
            "111122223333": "Shared"
          }
        }
      }
    },
    "steps": [
      {
        "dialogs": [
          null,
          "{SANDBOX}/org.json"
        ]
      },
      {
        "call": "orgConfig:export",
        "args": [
          "  Acme  "
        ],
        "expect": {
          "canceled": true
        }
      },
      {
        "call": "orgConfig:export",
        "args": [
          "  Acme  "
        ],
        "expect": {
          "success": true,
          "path": "{SANDBOX}/org.json"
        }
      }
    ],
    "then": {
      "sandboxFiles": {
        "org.json": {
          "text": "{\n  \"kind\": \"aws-profile-manager-org-config\",\n  \"version\": 1,\n  \"organizationName\": \"Acme\",\n  \"idpEntryUrl\": \"https://idp.example.test/sso\",\n  \"ssoStartUrl\": \"https://d-1234567890.awsapps.com/start\",\n  \"ssoRegion\": \"us-west-2\",\n  \"openWebUiApiUrl\": \"https://ai.example.test\",\n  \"openWebUiModel\": \"model-a\",\n  \"accountDisplayNames\": {\n    \"111122223333\": \"Shared\"\n  }\n}"
        }
      }
    }
  },
  {
    "id": "BE-ORG-002",
    "title": "Org config import rejects other files and cleans what it accepts",
    "given": {
      "sandboxFiles": {
        "wrong-kind.json": {
          "kind": "something-else"
        },
        "broken.json": "{",
        "messy.json": {
          "kind": "aws-profile-manager-org-config",
          "organizationName": "  Acme ",
          "ssoStartUrl": " https://d-1234567890.awsapps.com/start/#/ ",
          "ssoRegion": "",
          "openWebUiModel": 42,
          "accountDisplayNames": {
            "12345": "too short",
            "111122223333": " Shared ",
            "444455556666": "  "
          }
        }
      }
    },
    "steps": [
      {
        "dialogs": [
          null,
          "{SANDBOX}/wrong-kind.json",
          "{SANDBOX}/broken.json",
          "{SANDBOX}/messy.json"
        ]
      },
      {
        "call": "orgConfig:import",
        "expect": {
          "canceled": true
        }
      },
      {
        "call": "orgConfig:import",
        "expect": {
          "success": false,
          "error": "That file is not an organization configuration exported from this app."
        }
      },
      {
        "call": "orgConfig:import",
        "expect": {
          "success": false,
          "error": "$nonEmptyString"
        }
      },
      {
        "call": "orgConfig:import",
        "expect": {
          "success": true,
          "config": {
            "kind": "aws-profile-manager-org-config",
            "version": 1,
            "organizationName": "Acme",
            "ssoStartUrl": "https://d-1234567890.awsapps.com/start",
            "accountDisplayNames": {
              "111122223333": "Shared"
            }
          }
        }
      }
    ]
  }
]

{
  "function": "validateMasterPassword",
  "cases": [
    {
      "name": "7 chars",
      "args": [
        "1234567"
      ],
      "expect": "Password must be at least 8 characters."
    },
    {
      "name": "8 chars",
      "args": [
        "12345678"
      ],
      "expect": null
    },
    {
      "name": "128 chars",
      "args": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "expect": null
    },
    {
      "name": "129 chars",
      "args": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "expect": "Password must be no more than 128 characters."
    },
    {
      "name": "four emoji are four characters (too short)",
      "args": [
        "🔑🔑🔑🔑"
      ],
      "expect": "Password must be at least 8 characters."
    },
    {
      "name": "eight emoji are enough",
      "args": [
        "🔑🔑🔑🔑🔑🔑🔑🔑"
      ],
      "expect": null
    },
    {
      "name": "128 emoji are allowed",
      "args": [
        "🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑🔑"
      ],
      "expect": null
    }
  ],
  "note": "Length is counted in characters (Unicode code points). Fixed 2026-11-14: 1.x counted UTF-16 units, so four emoji passed the 8-character minimum."
}
